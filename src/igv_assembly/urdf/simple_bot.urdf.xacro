<?xml version="1.0"?>
<robot name="simple_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================= BASE LINK ================= -->
  <link name="base_link">
    <visual>
      <geometry><box size="0.4 0.25 0.1"/></geometry>
      <material name="gray"><color rgba="0.5 0.5 0.5 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="0.4 0.25 0.1"/></geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.03" ixy="0" ixz="0" iyy="0.07" iyz="0" izz="0.08"/>
    </inertial>
  </link>

  <!-- ================= WHEEL MACRO ================= -->
<!-- ================= WHEEL MACRO ================= -->
  <xacro:macro name="wheel" params="prefix x_reflect y_reflect">
    <link name="${prefix}_Wheel">
      <visual>
        <geometry><cylinder radius="0.1" length="0.05"/></geometry>
      </visual>
      <collision>
        <geometry><sphere radius="0.1"/></geometry>
      </collision>
      <inertial>
        <mass value="1.0"/>
        <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.005"/>
      </inertial>
    </link>

    <joint name="${prefix}_Joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_Wheel"/>
      <origin xyz="${x_reflect * 0.15} ${y_reflect * 0.15} 0" rpy="-1.5708 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    <gazebo reference="${prefix}_Wheel">
      <mu1>1.0</mu1>
      <mu2>0.2</mu2>
      <!-- fdir1 locks the high friction to the wheel's local X axis (forward) -->
      <fdir1>1 0 0</fdir1>
      <!-- Increased kp makes the wheels solid so the chassis stops sagging and scraping -->
      <kp>10000000.0</kp>
      <kd>1.0</kd>
      <minDepth>0.001</minDepth>
    </gazebo>
  </xacro:macro>

  <xacro:wheel prefix="FL" x_reflect="1"  y_reflect="1" />
  <xacro:wheel prefix="FR" x_reflect="1"  y_reflect="-1" />
  <xacro:wheel prefix="RL" x_reflect="-1" y_reflect="1" />
  <xacro:wheel prefix="RR" x_reflect="-1" y_reflect="-1" />

  <!-- ================= CAMERA ================= -->
  <link name="DepthCamVirtual">
    <visual><geometry><box size="0.02 0.08 0.02"/></geometry></visual>
  </link>
  <joint name="Cam_Joint" type="fixed">
    <parent link="base_link"/>
    <child link="DepthCamVirtual"/>
    <origin xyz="0.2 0 0.05" rpy="0 0 0"/>
  </joint>

  <link name="DepthCamOptical"/>
  <joint name="Cam_Optical_Joint" type="fixed">
    <parent link="DepthCamVirtual"/>
    <child link="DepthCamOptical"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- ================= GAZEBO SENSORS & CONTROL ================= -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find igv_assembly)/config/simple_controllers.yaml</parameters>
    </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>

  <gazebo reference="DepthCamVirtual">
    <sensor type='rgbd_camera' name="Depth_Camera">
      <always_on>true</always_on>
      <update_rate>30.0</update_rate>
      <topic>depth_camera</topic>
      <camera name="depth_camera"> 
        <optical_frame_id>DepthCamOptical</optical_frame_id>
        <horizontal_fov>1.047</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.1</near><far>10.0</far></clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- ================= ROS 2 CONTROL HARDWARE ================= -->
  <ros2_control name="IgnitionSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="FL_Joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="FR_Joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="RL_Joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="RR_Joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>
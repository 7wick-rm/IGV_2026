      filename="ignition-gazebo-imu-system"
      name="ignition::gazebo::systems::Imu">
    </plugin>
  </gazebo>

  <gazebo reference="DepthCamVirtual">
    <sensor type='rgbd_camera' name="Depth_Camera">
      <always_on>true</always_on>
      <update_rate>15.0</update_rate>
      <topic>depth_camera</topic>
      <camera name="depth_camera"> 
        <optical_frame_id>DepthCamOptical</optical_frame_id>
        <horizontal_fov>1.777</horizontal_fov>
        <image> 
          <width>1280</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
            <near>
              0.1
            </near>
            <far>
              10.0
            </far>
        </clip>
        <lens>
          <intrinsics>
            <fx>520.3729858398438</fx>
            <fy>520.3729858398438</fy>
            <cx>654.4447631835938</cx>
            <cy>365.853271484375</cy>
            <s>0</s>
          </intrinsics>
        </lens>
      </camera>
    </sensor>
  </gazebo>
